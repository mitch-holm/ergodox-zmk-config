#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define LAYER_BASE 0
#define LAYER_SYMB 1
#define LAYER_FN 2
#define LAYER_SYS 3

/ {
	keymap {
		compatible = "zmk,keymap";

		layer_0 {
			display-name = "base";
			bindings = <
				&bootloader
				&kp EQUAL      &kp NUMBER_1 &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4    &kp NUMBER_5     &kp ESCAPE        &tog LAYER_SYMB  &kp NUMBER_6      &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9 &kp NUMBER_0    &kp MINUS
				&kp CAPSLOCK   &kp Q        &kp W         &kp E          &kp R           &kp T            &mo LAYER_FN      &kp LEFT_BRACKET &kp Y             &kp U          &kp I          &kp O        &kp P           &kp RIGHT_BRACKET
				&kp TAB        &kp A        &kp S         &kp D          &kp F           &kp G                                               &kp H             &kp J          &kp K          &kp L        &kp SEMICOLON   &kp SINGLE_QUOTE
				&kp LEFT_SHIFT &kp Z        &kp X         &kp C          &kp V           &kp B            &kp K_APPLICATION &kp PRINTSCREEN  &kp N             &kp M          &kp COMMA      &kp PERIOD   &kp SLASH       &kp RIGHT_SHIFT
				&kp LEFT_GUI   &kp GRAVE    &kp BACKSLASH &kp LEFT_ARROW &kp RIGHT_ARROW                                                                       &kp LEFT_ARROW &kp DOWN_ARROW &kp UP_ARROW &kp RIGHT_ARROW &kp RIGHT_GUI
				                                                                         &kp LEFT_CONTROL &kp LEFT_ALT      &kp RIGHT_ALT    &kp RIGHT_CONTROL
				                                                         &kp BACKSPACE   &kp DELETE       &kp PAGE_UP       &kp HOME         &kp RETURN        &kp SPACE
				                                                                                          &kp PAGE_DOWN     &kp END
			>;
		};

		layer_1 {
			display-name = "symb";
			bindings = <
				&bootloader
				&kp MINUS &kp EXCLAMATION &kp AT_SIGN &kp HASH       &kp DOLLAR      &kp PERCENT &kp ESCAPE &to LAYER_BASE &kp CARET    &kp AMPERSAND   &kp ASTERISK    &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &none
				&none     &none           &none       &none          &none           &none       &none      &none          &none        &kp KP_NUMBER_7 &kp KP_NUMBER_8 &kp KP_NUMBER_9      &none                 &none
				&kp TAB   &none           &none       &none          &none           &none                                 &none        &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp KP_NUMBER_6      &none                 &none
				&none     &none           &none       &none          &none           &none       &none      &none          &none        &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_3      &kp SLASH             &none
				&trans    &none           &none       &kp LEFT_ARROW &kp RIGHT_ARROW                                                    &kp KP_NUMBER_0 &kp PERIOD      &kp PERIOD           &none                 &trans
				                                                                     &trans      &trans     &trans         &trans
				                                                     &kp BACKSPACE   &kp DELETE  &none      &kp UP_ARROW   &kp KP_ENTER &kp SPACE
				                                                                                 &none      &kp DOWN_ARROW
			>;
		};

		layer_2 {
			display-name = "fn";
			bindings = <
				&bootloader
				&kp F13 &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F11              &kp F12           &kp F6         &kp F7           &kp F8 &kp F9 &kp F10 &kp F14
				&none   &none  &none  &none  &none  &none  &none                &mo LAYER_SYS     &none          &none            &none  &none  &none   &none
				&none   &none  &none  &none  &none  &none                                         &none          &none            &none  &none  &none   &none
				&none   &none  &none  &none  &none  &none  &none                &none             &none          &none            &none  &none  &none   &none
				&none   &none  &none  &none  &none                                                               &kp C_NEXT       &none  &none  &none   &none
				                                    &none  &kp C_BRIGHTNESS_INC &kp C_VOLUME_UP   &none
				                             &none  &none  &none                &kp C_MUTE        &kp C_PREVIOUS &kp C_PLAY_PAUSE
				                                           &kp C_BRIGHTNESS_DEC &kp C_VOLUME_DOWN
			>;
		};

		layer_3 {
			display-name = "sys";
			bindings = <
				&bootloader
				&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &studio_unlock &sys_reset &none &none &none &none &none &bootloader
				&out OUT_USB &none        &none        &none        &none        &none &none          &none      &none &none &none &none &none &none
				&out OUT_BLE &none        &none        &none        &none        &none                           &none &none &none &none &none &none
				&none        &none        &none        &none        &none        &none &none          &none      &none &none &none &none &none &bt BT_CLR
				&none        &none        &none        &none        &none                                              &none &none &none &none &none
				                                                                 &none &none          &none      &none
				                                                    &none        &none &none          &none      &none &none
				                                                                       &none          &none
			>;
		};

		extra_1 {
			display-name = "extra1";
			status = "reserved";
		};

		extra_2 {
			display-name = "extra2";
			status = "reserved";
		};

		extra_3 {
			display-name = "extra3";
			status = "reserved";
		};
	};
};
